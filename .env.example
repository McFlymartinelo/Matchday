PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production
# En production, une valeur unique et forte est obligatoire (pas de fallback).
BSD_API_TOKEN=your-bsd-token
BSD_BASE_URL=https://sports.bzzoiro.com
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@matchday.app
MAIL_FROM=Matchday <noreply@matchday.app>
# SMTP (port 587 ou 465 — pas le 25). Boîte du domaine, pas Gmail perso.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Variante URL : SMTP_URL=smtps://user:pass@smtp.example.com:465
NOTIFICATION_MORNING_HOUR=8
NOTIFICATION_MORNING_TZ=Europe/Paris
NOTIFICATION_MORNING_ENABLED=true
SYNC_SECRET=
